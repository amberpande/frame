# Copy to .env and fill in. Nothing here is read automatically — export it, or
# use a tool like direnv / dotenv. .env is gitignored.

# --- engine ----------------------------------------------------------------
# "duckdb" (default) runs against the local fixture with no credentials.
# "snowflake" sends every compiled query to the warehouse.
FRAME_ENGINE=duckdb

# --- Snowflake -------------------------------------------------------------
SNOWFLAKE_ACCOUNT=abcd-xy12345          # the account identifier, e.g. myorg-myaccount
SNOWFLAKE_USER=frame_service
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=OPS
SNOWFLAKE_ROLE=FRAME_ANALYST_ALL

# Serving and batch use different warehouses on purpose: a nightly rebuild must
# never queue ahead of a dashboard someone is looking at.
SNOWFLAKE_WAREHOUSE=FRAME_INTERACTIVE_XS

# Key-pair auth is the right choice for a service. Password auth works for a
# first connection; SSO/externalbrowser will not work in a container.
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/frame_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=

# --- shared cache ----------------------------------------------------------
# OPTIONAL. Leave unset for development and single-task deployments; the cache
# is then per-task, which is correct for one task. Set it before scaling out: a
# cache inside the container is a cache per task, which multiplies warehouse
# load by the task count. Managed Redis/Valkey in the same VPC - never a
# sidecar. Needs `pip install -e ".[redis]"`. See docs/deployment.md
# FRAME_REDIS_URL=rediss://frame-cache.abc123.use1.cache.amazonaws.com:6379
FRAME_REDIS_TIMEOUT=0.25
FRAME_CACHE_L1_ENTRIES=512
FRAME_CACHE_L1_TTL=15

# --- limits ----------------------------------------------------------------
# The compiler will not emit past this, whatever a spec asks for.
FRAME_MAX_ROWS=50000
# A runaway interactive query dies rather than holding a warehouse open.
FRAME_STATEMENT_TIMEOUT=30
# Unfiltered scans of sources larger than this are refused.
FRAME_LARGE_TABLE_ROWS=50000000
# How long a source's max-date watermark is reused. Without this, resolving
# @latest_close costs a warehouse round-trip on every single request.
FRAME_WATERMARK_TTL=60
# Heavy plans route here instead of the interactive warehouse.
# FRAME_SNOWFLAKE_WAREHOUSE_HEAVY=FRAME_BATCH_S

# --- dev -------------------------------------------------------------------
FRAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
